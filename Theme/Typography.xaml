<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Tipografía al estilo Apple (SF Pro).
        En Windows el equivalente óptico más cercano es Segoe UI Variable:
        "Display" para titulares y cifras grandes (formas más ajustadas),
        "Text" para cuerpo y etiquetas (mayor apertura, más legible en cuerpos chicos).
        La lista separada por comas actúa como cadena de respaldo.

        Reglas del sistema:
          · Sentence case en todos los títulos. Nada de MAYÚSCULAS gritadas.
          · Como máximo tres pesos: Regular, Medium, SemiBold.
          · Cifras tabulares en toda métrica que se actualice en vivo,
            para que los dígitos no bailen entre refrescos.
    -->

    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI, Segoe UI Variable, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Cifra heroica: el número grande de una tarjeta -->
    <Style x:Key="T.Hero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="T.Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- Título de tarjeta / sección -->
    <Style x:Key="T.Headline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
    </Style>

    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Texto de apoyo: descripciones, unidades, pies de tarjeta -->
    <Style x:Key="T.Secondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Etiqueta de campo en una ficha técnica -->
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextTertiary}"/>
    </Style>

    <!-- Valor de campo en una ficha técnica -->
    <Style x:Key="T.Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="T.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextTertiary}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- Identificadores técnicos: seriales, part numbers, PID, hashes -->
    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextSecondary}"/>
    </Style>

</ResourceDictionary>
