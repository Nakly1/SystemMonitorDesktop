<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Radios de esquina: continuos y generosos, como en macOS -->
    <CornerRadius x:Key="R.Card">14</CornerRadius>
    <CornerRadius x:Key="R.Control">9</CornerRadius>
    <CornerRadius x:Key="R.Pill">999</CornerRadius>

    <!-- ══════════════ Superficies ══════════════ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Br.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.Card}"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Tarjeta protagonista: recibe el resplandor morado -->
    <Style x:Key="CardHero" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{StaticResource Br.HeroGlow}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.StrokeStrong}"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <!-- Hueco hundido: gráficos, tablas, bloques de datos dentro de una tarjeta -->
    <Style x:Key="Well" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Br.Well}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.StrokeSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.Control}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Br.StrokeSoft}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ══════════════ Botones ══════════════ -->

    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Br.SurfaceRaised}"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.StrokeStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource R.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.SurfaceHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Br.AccentDeep}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.AccentTint}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{StaticResource Br.AccentGradient}"
                            CornerRadius="{StaticResource R.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.AccentBright}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.AccentDeep}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.Stroke}"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextSecondary}"/>
    </Style>

    <!-- Acción destructiva discreta (finalizar proceso) -->
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.Stroke}"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextTertiary}"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource R.Pill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26F2556A"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Br.Critical}"/>
                            <Setter Property="Foreground" Value="{StaticResource Br.Critical}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botones del chrome de ventana -->
    <Style x:Key="BtnCaption" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextSecondary}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.SurfaceHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnCaptionClose" TargetType="Button" BasedOn="{StaticResource BtnCaption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE0364B"/>
                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Barras de progreso ══════════════ -->

    <Style x:Key="Meter" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="#FF221B32"/>
        <Setter Property="Foreground" Value="{StaticResource Br.Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource R.Pill}"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{StaticResource R.Pill}"
                                HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MeterLarge" TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
        <Setter Property="Height" Value="10"/>
    </Style>

    <!-- ══════════════ Scrollbar ══════════════ -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="#FF2E2545" CornerRadius="3" Margin="3,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.AccentDeep}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Iconografía ══════════════ -->
    <!--
        Dibujadas a mano sobre una retícula de 24 px en vez de usar Segoe MDL2:
        así el juego completo comparte grosor, redondeo y densidad, que es lo
        que hace que un icono se lea como parte de un sistema y no como un
        pictograma prestado.
    -->
    <Geometry x:Key="Icon.Brand">M4,13.5 H8 V21 H4 Z M10,7.5 H14 V21 H10 Z M16,3 H20 V21 H16 Z</Geometry>
    <Geometry x:Key="Icon.Overview">M3,3 H10.2 V10.2 H3 Z M13.8,3 H21 V10.2 H13.8 Z M3,13.8 H10.2 V21 H3 Z M13.8,13.8 H21 V21 H13.8 Z</Geometry>
    <Geometry x:Key="Icon.Memory">M5,7 H19 V17 H5 Z M8,3.5 H10 V7 H8 Z M13,3.5 H15 V7 H13 Z M8,17 H10 V20.5 H8 Z M13,17 H15 V20.5 H13 Z</Geometry>
    <Geometry x:Key="Icon.Storage">M3,5 H21 V10.5 H3 Z M3,13.5 H21 V19 H3 Z</Geometry>
    <Geometry x:Key="Icon.Processes">M3.5,5 H20.5 V7.2 H3.5 Z M3.5,10.9 H16 V13.1 H3.5 Z M3.5,16.8 H11.5 V19 H3.5 Z</Geometry>
    <Geometry x:Key="Icon.Evidence">M12,2 L20,5.2 V11 C20,16.2 16.4,20.2 12,22 C7.6,20.2 4,16.2 4,11 V5.2 Z</Geometry>
    <Geometry x:Key="Icon.Tools">M3,6.4 H21 V8.6 H3 Z M3,15.4 H21 V17.6 H3 Z M7.5,3.5 H9.7 V11.5 H7.5 Z M14.3,12.5 H16.5 V20.5 H14.3 Z</Geometry>

    <!-- ══════════════ Navegación lateral ══════════════ -->

    <!--
        Cada entrada es un RadioButton: la exclusión mutua ya viene resuelta por
        el propio control, y a diferencia de un TabItem la vista sigue siendo
        XAML normal, con nombres accesibles desde el code-behind.
    -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="ShellNav"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9"
                                Margin="12,1" Padding="11,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Icon" Grid.Column="0"
                                      Data="{TemplateBinding Tag}"
                                      Fill="{StaticResource Br.TextTertiary}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- Riel de selección al estilo de las barras laterales de macOS -->
                        <Border x:Name="Rail" Width="3" Height="18" CornerRadius="2"
                                HorizontalAlignment="Left" Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#80171224"/>
                            <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Br.AccentTintStrong}"/>
                            <Setter TargetName="Rail" Property="Background" Value="{StaticResource Br.AccentBright}"/>
                            <Setter TargetName="Icon" Property="Fill" Value="{StaticResource Br.AccentBright}"/>
                            <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Píldoras / etiquetas ══════════════ -->

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Br.AccentTint}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.AccentDeep}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.Pill}"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Br.AccentBright}"/>
    </Style>

    <!-- ══════════════ Entrada de texto ══════════════ -->

    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Br.Well}"/>
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Br.AccentBright}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Br.AccentDeep}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Br.Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource R.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Br.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Tooltip ══════════════ -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Br.TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Br.SurfaceRaised}"
                            BorderBrush="{StaticResource Br.StrokeStrong}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
