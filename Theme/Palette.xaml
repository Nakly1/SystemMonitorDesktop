<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Paleta System Monitor
        Negro (con matiz violeta) · Morado profundo · Blanco cálido.
        Se evita el negro puro en las superficies grandes: produce halación
        y fatiga visual en pantallas OLED/IPS. El negro puro queda reservado
        para sombras y para el fondo del chrome.
    -->

    <!-- Superficies -->
    <Color x:Key="C.Void">#FF050409</Color>
    <Color x:Key="C.Base">#FF0A0810</Color>
    <Color x:Key="C.Sidebar">#FF0D0A15</Color>
    <Color x:Key="C.Surface">#FF13101C</Color>
    <Color x:Key="C.SurfaceRaised">#FF1A1526</Color>
    <Color x:Key="C.SurfaceHover">#FF221B32</Color>
    <Color x:Key="C.Well">#FF0B0912</Color>

    <!-- Trazos -->
    <Color x:Key="C.Stroke">#FF231C33</Color>
    <Color x:Key="C.StrokeSoft">#FF191324</Color>
    <Color x:Key="C.StrokeStrong">#FF322847</Color>

    <!-- Texto -->
    <Color x:Key="C.TextPrimary">#FFF4F2F8</Color>
    <Color x:Key="C.TextSecondary">#FFA79FBC</Color>
    <Color x:Key="C.TextTertiary">#FF6B6483</Color>
    <Color x:Key="C.TextInverse">#FF0A0810</Color>

    <!-- Acento morado -->
    <Color x:Key="C.Accent">#FF8B5CF6</Color>
    <Color x:Key="C.AccentBright">#FFA78BFA</Color>
    <Color x:Key="C.AccentDeep">#FF6D28D9</Color>
    <Color x:Key="C.AccentPressed">#FF5B21B6</Color>
    <Color x:Key="C.AccentTint">#FF1E1633</Color>
    <Color x:Key="C.AccentTintStrong">#FF2B1F4A</Color>

    <!-- Estados. Se mantienen desaturados para no romper la paleta. -->
    <Color x:Key="C.Ok">#FF9F7BF0</Color>
    <Color x:Key="C.Warn">#FFE0A44A</Color>
    <Color x:Key="C.Critical">#FFF2556A</Color>
    <Color x:Key="C.Positive">#FF5FD6A4</Color>

    <!-- ── Brochas ── -->
    <SolidColorBrush x:Key="Br.Void" Color="{StaticResource C.Void}"/>
    <SolidColorBrush x:Key="Br.Base" Color="{StaticResource C.Base}"/>
    <SolidColorBrush x:Key="Br.Sidebar" Color="{StaticResource C.Sidebar}"/>
    <SolidColorBrush x:Key="Br.Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="Br.SurfaceRaised" Color="{StaticResource C.SurfaceRaised}"/>
    <SolidColorBrush x:Key="Br.SurfaceHover" Color="{StaticResource C.SurfaceHover}"/>
    <SolidColorBrush x:Key="Br.Well" Color="{StaticResource C.Well}"/>

    <SolidColorBrush x:Key="Br.Stroke" Color="{StaticResource C.Stroke}"/>
    <SolidColorBrush x:Key="Br.StrokeSoft" Color="{StaticResource C.StrokeSoft}"/>
    <SolidColorBrush x:Key="Br.StrokeStrong" Color="{StaticResource C.StrokeStrong}"/>

    <SolidColorBrush x:Key="Br.TextPrimary" Color="{StaticResource C.TextPrimary}"/>
    <SolidColorBrush x:Key="Br.TextSecondary" Color="{StaticResource C.TextSecondary}"/>
    <SolidColorBrush x:Key="Br.TextTertiary" Color="{StaticResource C.TextTertiary}"/>
    <SolidColorBrush x:Key="Br.TextInverse" Color="{StaticResource C.TextInverse}"/>

    <SolidColorBrush x:Key="Br.Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="Br.AccentBright" Color="{StaticResource C.AccentBright}"/>
    <SolidColorBrush x:Key="Br.AccentDeep" Color="{StaticResource C.AccentDeep}"/>
    <SolidColorBrush x:Key="Br.AccentTint" Color="{StaticResource C.AccentTint}"/>
    <SolidColorBrush x:Key="Br.AccentTintStrong" Color="{StaticResource C.AccentTintStrong}"/>

    <SolidColorBrush x:Key="Br.Ok" Color="{StaticResource C.Ok}"/>
    <SolidColorBrush x:Key="Br.Warn" Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="Br.Critical" Color="{StaticResource C.Critical}"/>
    <SolidColorBrush x:Key="Br.Positive" Color="{StaticResource C.Positive}"/>

    <!-- Degradados -->
    <LinearGradientBrush x:Key="Br.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.AccentBright}" Offset="0"/>
        <GradientStop Color="{StaticResource C.AccentDeep}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Br.HeroGlow" StartPoint="0,0" EndPoint="1,0.6">
        <GradientStop Color="#FF1B1230" Offset="0"/>
        <GradientStop Color="#FF13101C" Offset="0.55"/>
        <GradientStop Color="#FF13101C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Br.SidebarFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF120C1F" Offset="0"/>
        <GradientStop Color="{StaticResource C.Sidebar}" Offset="0.4"/>
        <GradientStop Color="{StaticResource C.Sidebar}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
