<Window x:Class="SystemMonitorDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="System Monitor"
        Height="770" Width="1180"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource Br.Base}"
        Foreground="{StaticResource Br.TextPrimary}"
        FontFamily="{StaticResource Font.Text}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource Br.Base}"
            BorderBrush="{StaticResource Br.Stroke}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════ Identidad (esquina superior izquierda) ══════════ -->
            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Br.Sidebar}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0">
                    <Border Width="24" Height="24" CornerRadius="7"
                            Background="{StaticResource Br.AccentGradient}"
                            Margin="0,0,11,0">
                        <Path Data="{StaticResource Icon.Brand}" Fill="#FF0A0810"
                              Width="11" Height="11" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="System Monitor" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Br.TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ══════════ Barra de título con métricas vivas ══════════ -->
            <Grid Grid.Row="0" Grid.Column="1" Background="{StaticResource Br.Base}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right" Margin="0,0,4,0">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock Text="CPU" Style="{StaticResource T.Caption}"
                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="CpuPill" Text="—" Style="{StaticResource T.Value}"
                                   FontSize="12" MinWidth="46" VerticalAlignment="Center"/>
                        <Border Width="1" Height="12" Background="{StaticResource Br.Stroke}"
                                Margin="6,0,12,0"/>
                        <TextBlock Text="RAM" Style="{StaticResource T.Caption}"
                                   VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="RamPill" Text="—" Style="{StaticResource T.Value}"
                                   FontSize="12" MinWidth="46" VerticalAlignment="Center"/>
                        <Border Width="1" Height="12" Background="{StaticResource Br.Stroke}"
                                Margin="6,0,12,0"/>
                        <TextBlock x:Name="ClockText" Text="—" Style="{StaticResource T.Caption}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Style="{StaticResource BtnCaption}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="Minimizar"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource BtnCaption}"
                            Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximizar"/>
                    <Button Style="{StaticResource BtnCaptionClose}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="Cerrar"/>
                </StackPanel>
            </Grid>

            <!-- ══════════ Barra lateral ══════════ -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Br.Sidebar}"
                    BorderBrush="{StaticResource Br.Stroke}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">

                    <StackPanel DockPanel.Dock="Bottom" Margin="22,0,20,18">
                        <Border Style="{StaticResource Divider}" Margin="0,0,0,14"/>
                        <TextBlock Text="System Monitor 2.0" FontSize="11" FontWeight="Medium"
                                   Foreground="{StaticResource Br.TextSecondary}"/>
                        <TextBlock x:Name="FooterStatus" Text="Iniciando…"
                                   FontSize="10.5" Foreground="{StaticResource Br.TextTertiary}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="Supervisión"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Br.TextTertiary}"
                               Margin="23,18,20,8"/>

                    <StackPanel VerticalAlignment="Top">
                        <RadioButton x:Name="NavOverview" Content="Resumen" IsChecked="True"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Overview}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavMemory" Content="Memoria"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Memory}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavStorage" Content="Almacenamiento"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Storage}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavProcesses" Content="Procesos"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Processes}"
                                     Checked="Nav_Checked"/>

                        <TextBlock Text="Equipo" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Br.TextTertiary}"
                                   Margin="23,18,20,8"/>

                        <RadioButton x:Name="NavEvidence" Content="Evidencia"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Evidence}"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTools" Content="Herramientas"
                                     Style="{StaticResource NavItem}"
                                     Tag="{StaticResource Icon.Tools}"
                                     Checked="Nav_Checked"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ══════════ Contenido ══════════ -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1"
                            Background="{StaticResource Br.Base}"/>
        </Grid>
    </Border>
</Window>
